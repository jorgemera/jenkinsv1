<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
	xmlns:sec="http://www.thymeleaf.org/extras/spring-security">

<head>

<link rel="stylesheet" type="text/css"
	th:href="@{/css/bootstrap/bootstrap.min.css}">
<style type="text/css">
.card-header {
	padding: var(- -bs-card-cap-padding-y) var(- -bs-card-cap-padding-x);
	margin-bottom: 0;
	color: #ec13b9;
	border: 1px solid #b5b5b5;
    background: #b8b8b8 url(temas/siirfe-pink/css/images/ui-bg_inset-soft_80_b8b8b8_1x100.png) 50% 50% repeat-x;
	border-bottom: var(- -bs-card-border-width) solid
		var(- -bs-card-border-color);
}

.submit {
	border: 1px solid #ef52ca;
	background: #eb66cc url(temas/siirfe-pink/css/images/ui-bg_inset-soft_100_eb66cc_1x100.png) 50% 50% repeat-x;
	font-weight: bold;
	color: #ef52ca #242424;
}

.card {
	border: 3px solid #aaaaaa;
	background: #ebebeb url(temas/siirfe-pink/css/images/ui-bg_hexagon_100_ebebeb_12x10.png) 50% 50% repeat;
	color: #222222;
}

body {
	background: #b3b3b3;
}
</style>
</head>

<body>
	<header></header>
	<br><br><br><br><br><br><br><br>
	<div class="row">
		<div class="col-sm-4"></div>
		<div class="card text-center col-sm-4">
			<div class="card-body">
				<div class="card-header bg-pink">Login
					depuracion-duplicados-correctivo</div>
				<br>
				<div>
					<form th:action="@{/login}" method="post">
						<div class="alert alert-danger" th:if="${error != null}"
							th:text="${error}"></div>
						<div class="row input-group mb-3">
							<div class="col-sm-6" style = "text-align: right;">
								<label class="card-text"><strong>Usuario: </strong></label>
							</div>
							<div class="col-sm-4" style = "text-align: left;">
								<input type="text" class="form-control" name="username" id="username"
									placeholder="UserName" autofocus required />
							</div>
							<div class="col-sm-2" style = "text-align: left;">
								
							</div>
						</div>
						<br>
						<div class="row input-group mb-3">
							<div class="col-sm-6" style = "text-align: right;">
								<label class="card-text"><strong>Contrase&ntilde;a:
								</strong></label>
							</div>
							<div class="col-sm-4" style = "text-align: left;">
								<input type="password" class="form-control" name="password" id="password"
									placeholder="Password" required />
							</div>
							<div class="col-sm-2" style = "text-align: left;">
								
							</div>
						</div>
						<br>
						<div class="form-group">
							<input class="submit" type="submit" value="Entrar" />
						</div>
						<input type="hidden" th:name="${_csrf.parameterName}"
							th:value="${_csrf.token}" />
					</form>
				</div>
			</div>
		</div>
		<div class="col-sm-4"></div>
	</div>
	<footer></footer>
	<script type="text/javascript" th:src="@{js/jquery-3.6.0.js}"></script>
	<script type="text/javascript"
		th:src="@{js/bootstrap/bootstrap.bundle.min.js}"></script>
</body>
</html>