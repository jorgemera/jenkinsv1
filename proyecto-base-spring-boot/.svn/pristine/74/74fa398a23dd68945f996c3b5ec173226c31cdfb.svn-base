/**
 * Se modifica el onclick method() ya que segun las politicas de seguridad CSP no se debe tener de esa manera en el html
 * siempre se debe de hacer de esta manera tener el codigo dentro de un js y de ahi invocar al archivo en el html 
 */
 
document.getElementById("cerrarSesion").addEventListener("click", myFunction);

function myFunction(){
  document.logoutForm.submit();
}